@model BLL.DTOs.LoginDTO

@{
    ViewData["Title"] = "Sign In";
}

<style>
    body {
        background: #f3f4f6;
    }

    .auth-wrapper {
        min-height: 78vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .auth-card {
        width: 440px;
        border: none;
        border-radius: 24px;
        box-shadow: 0 18px 45px rgba(0, 0, 0, 0.14);
        overflow: hidden;
    }

    .auth-header {
        background: linear-gradient(135deg, #111827, #2563eb);
        color: white;
        padding: 34px 28px;
        text-align: center;
    }

    .auth-header h1 {
        font-weight: 800;
        margin-bottom: 6px;
    }

    .auth-header p {
        color: #e5e7eb;
        margin-bottom: 0;
    }

    .auth-body {
        padding: 30px;
        background: white;
    }

    .form-control {
        border-radius: 12px;
        padding: 11px 13px;
    }

    .auth-btn {
        border-radius: 12px;
        padding: 11px;
        font-weight: 700;
    }
</style>

<div class="auth-wrapper">
    <div class="card auth-card">

        <div class="auth-header">
            <h1>Welcome Back</h1>
            <p>Sign in to manage your clinic dashboard</p>
        </div>

        <div class="auth-body">

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">
                    @TempData["SuccessMessage"]
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["ErrorMessage"]
                </div>
            }

            <form asp-action="Login" method="post">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                <div class="form-group mb-3">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="Enter Email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Password"></label>
                    <input asp-for="Password" type="password" class="form-control" placeholder="Enter Password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="d-grid mb-3">
                    <input type="submit" value="Login" class="btn btn-primary auth-btn" />
                </div>

                <p class="text-center mb-0">
                    Don't have an account?
                    <a asp-controller="Account" asp-action="Register">Sign Up</a>
                </p>

            </form>
        </div>

    </div>
</div>