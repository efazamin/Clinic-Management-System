@model BLL.DTOs.RegisterDTO

@{
    ViewData["Title"] = "Sign Up";
}

<style>
    body {
        background: #f3f4f6;
    }

    .auth-wrapper {
        min-height: 78vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .auth-card {
        width: 480px;
        border: none;
        border-radius: 24px;
        box-shadow: 0 18px 45px rgba(0, 0, 0, 0.14);
        overflow: hidden;
    }

    .auth-header {
        background: linear-gradient(135deg, #111827, #059669);
        color: white;
        padding: 34px 28px;
        text-align: center;
    }

        .auth-header h1 {
            font-weight: 800;
            margin-bottom: 6px;
        }

        .auth-header p {
            color: #e5e7eb;
            margin-bottom: 0;
        }

    .auth-body {
        padding: 30px;
        background: white;
    }

    .form-control {
        border-radius: 12px;
        padding: 11px 13px;
    }

    .auth-btn {
        border-radius: 12px;
        padding: 11px;
        font-weight: 700;
    }
</style>

<div class="auth-wrapper">
    <div class="card auth-card">

        <div class="auth-header">
            <h1>Create Account</h1>
            <p>Start managing your clinic system</p>
        </div>

        <div class="auth-body">

            <form asp-action="Register" method="post">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                <div class="form-group mb-3">
                    <label asp-for="FullName">Full Name</label>
                    <input asp-for="FullName" class="form-control" placeholder="Enter Full Name" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="Enter Email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Password"></label>
                    <input asp-for="Password" type="password" class="form-control" placeholder="Enter Password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="ConfirmPassword">Confirm Password</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Confirm Password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <div class="d-grid mb-3">
                    <input type="submit" value="Create Account" class="btn btn-success auth-btn" />
                </div>

                <p class="text-center mb-0">
                    Already have an account?
                    <a asp-controller="Account" asp-action="Login">Sign In</a>
                </p>

            </form>
        </div>

    </div>
</div>